package com.chainpay.app

import android.content.Context
import android.content.Intent
import android.widget.Toast
import com.reown.appkit.client.AppKit
import com.reown.appkit.client.models.request.Request
import com.reown.appkit.client.models.request.SentRequestResult

object TestPaymentRequester {

    fun sendSelfTest(
        context: Context,
        walletAddress: String
    ) {
        if (walletAddress.isBlank()) {
            Toast.makeText(
                context,
                "Connected wallet address is unavailable.",
                Toast.LENGTH_LONG
            ).show()
            return
        }

        val params =
            """[{"from":"$walletAddress","to":"$walletAddress","value":"0xE8D4A51000"}]"""

        val request = Request(
            method = "eth_sendTransaction",
            params = params
        )

        try {
            AppKit.request(
                request = request,
                onSuccess = { _: SentRequestResult ->
                    val intent =
                        context.packageManager
                            .getLaunchIntentForPackage(
                                "io.metamask"
                            )

                    if (intent != null) {
                        intent.addFlags(
                            Intent.FLAG_ACTIVITY_NEW_TASK
                        )

                        context.startActivity(
                            intent
                        )
                    } else {
                        Toast.makeText(
                            context,
                            "Payment request sent. Open MetaMask to approve it.",
                            Toast.LENGTH_LONG
                        ).show()
                    }
                },
                onError = { error: Throwable ->
                    Toast.makeText(
                        context,
                        "Payment request failed: ${error.localizedMessage}",
                        Toast.LENGTH_LONG
                    ).show()
                }
            )
        } catch (error: Exception) {
            Toast.makeText(
                context,
                "Payment request failed: ${error.localizedMessage}",
                Toast.LENGTH_LONG
            ).show()
        }
    }
}


