package com.chainpay.app

import android.content.ClipData
import android.content.ClipboardManager
import android.content.Context
import android.content.Intent
import android.net.Uri
import android.os.Handler
import android.os.Looper
import android.widget.Toast
import com.reown.android.CoreClient
import com.reown.appkit.client.AppKit
import com.reown.appkit.client.Modal

object DirectWalletConnector {

    fun connect(context: Context) {
        val main = Handler(Looper.getMainLooper())

        val pairing = CoreClient.Pairing.create { error ->
            main.post {
                Toast.makeText(
                    context,
                    "Pairing failed: ${error.throwable.message}",
                    Toast.LENGTH_LONG
                ).show()
            }
        }

        if (pairing == null) {
            Toast.makeText(
                context,
                "Could not create WalletConnect pairing.",
                Toast.LENGTH_LONG
            ).show()
            return
        }

        val ethereum = Modal.Model.Namespace.Proposal(
            chains = listOf("eip155:1"),
            methods = listOf(
                "eth_sendTransaction",
                "personal_sign",
                "eth_signTypedData",
                "eth_signTypedData_v4"
            ),
            events = listOf(
                "accountsChanged",
                "chainChanged"
            )
        )

        val params = Modal.Params.ConnectParams(
            sessionNamespaces = mapOf("eip155" to ethereum),
            pairing = pairing
        )

        AppKit.connect(
            connectParams = params,
            onSuccess = { uri ->
                main.post {
                    openWallet(context, uri)
                }
            },
            onError = { error ->
                main.post {
                    Toast.makeText(
                        context,
                        "WalletConnect: ${error.throwable.message}",
                        Toast.LENGTH_LONG
                    ).show()
                }
            }
        )
    }

    private fun openWallet(context: Context, uri: String) {
        try {
            val encodedUri = Uri.encode(uri)
            val metamaskUri = Uri.parse(
                "metamask://wc?uri=$encodedUri"
            )

            val intent = Intent(
                Intent.ACTION_VIEW,
                metamaskUri
            ).apply {
                setPackage("io.metamask")
                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            }

            context.startActivity(intent)
        } catch (_: Exception) {
            val clipboard = context.getSystemService(
                Context.CLIPBOARD_SERVICE
            ) as ClipboardManager

            clipboard.setPrimaryClip(
                ClipData.newPlainText(
                    "WalletConnect URI",
                    uri
                )
            )

            Toast.makeText(
                context,
                "MetaMask could not open. WalletConnect URI copied.",
                Toast.LENGTH_LONG
            ).show()
        }
    }
}

